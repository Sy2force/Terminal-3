# Terminal 3 — variables d'environnement locales
# Copier ce fichier en .env.local et remplir avec vos vraies valeurs Supabase.

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_DEMO_MODE=false

# Connexion admin de secours (fallback mot de passe)
ADMIN_PASSWORD=change-me-in-production-min-8-chars
ADMIN_SESSION_SECRET=change-me-in-production-32-char-secret-key

# Sécurité des tâches planifiées (/api/cron/*)
CRON_SECRET=change-me-in-production-cron-secret

# Tests E2E optionnels
# TEST_BASE_URL=http://localhost:3000
# ADMIN_PASSWORD=your-admin-password
# TEST_USER_EMAIL=customer@example.com
# TEST_USER_PASSWORD=customer-password
